# Apache SPA fallback — serves index.html for all clean-URL routes
# so the JS router can read window.location.pathname and show the correct page.
# Real directories (blog/, budget-tool/, debt-tool/) pass through untouched.

Options -MultiViews
RewriteEngine On
RewriteBase /

# Pass through real files and real directories (blog, budget-tool, debt-tool, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Blog post clean URLs: /blog/posts/<slug> -> /blog/posts/<slug>.html
# Must come BEFORE the SPA catch-all, otherwise a post URL falls through to
# index.html and the visitor lands on the homepage instead of the article.
RewriteRule ^blog/posts/([A-Za-z0-9_-]+)/?$ /blog/posts/$1.html [L]

# Standalone static pages (must come BEFORE the SPA catch-all below)
RewriteRule ^how-it-works/?$     /how-it-works.html      [L]
RewriteRule ^faq/?$              /faq.html               [L]
RewriteRule ^packages/?$         /packages.html          [L]
RewriteRule ^contact-us/?$       /contact-us.html        [L]
RewriteRule ^privacy-policy/?$    /privacy-policy.html    [L]
RewriteRule ^terms-of-service/?$  /terms-of-service.html  [L]

# Rewrite all other single-level paths to index.html (SPA catch-all)
RewriteRule ^ /index.html [L]
